#!/bin/bash
# pet — el panel del bicho. La statusline solo enseña la cara; aqui esta todo.
#
#   pet          el panel
#   pet feed     darle de comer (+3 xp, hambre -2, maximo 4 al dia)
#   pet <evento> comida desde un hook: tests | commit | compact | tarea | reventon
#   pet cuenta <contador> [n]     suma a un contador de comportamiento
#   pet record <contador> <valor> guarda el maximo de un contador
#   pet sesion <fichero>          cierra una sesion: sus hechos pasan a contadores
#
# Ver README.md y VIDA.md.
SL_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export SL_DIR PET_ACCION="${1:-panel}" PET_NOTA="${2:-}" PET_EXTRA="${3:-}"
exec python3 - <<'PYEOF'
import json, os, sys, time

sys.path.insert(0, os.environ.get("SL_DIR", ""))
import bicho as BI

_TRUE = os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit")
R, B = BI.R, BI.B


def c(par):
    return BI.color(par, veinticuatro=_TRUE)


def barra(v, tope, ancho, lleno, hueco):
    v = max(0.0, min(float(tope), float(v)))
    f = int(round(ancho * v / tope)) if tope else 0
    return c(lleno) + "█" * f + c(hueco) + "░" * (ancho - f) + R


accion = os.environ.get("PET_ACCION", "panel")
nota = os.environ.get("PET_NOTA", "")
extra = os.environ.get("PET_EXTRA", "")

# ---------------------------------------------------------------------------
# CONTADORES — los que eligen la rama. No dan xp: solo describen como trabajas.
# ---------------------------------------------------------------------------
if accion in ("cuenta", "record"):
    if not nota:
        raise SystemExit(2)
    pet = BI.leer_pet()
    if accion == "cuenta":
        BI.contar(pet, nota, int(extra or 1))
    else:
        BI.marcar(pet, nota, int(extra or 0))
    BI.escribir_pet(pet)
    raise SystemExit(0)

if accion == "sesion":
    # Los hechos que solo la statusline ve (pico de uso, duracion, repo) se
    # convierten aqui en contadores, al cerrar la sesion.
    try:
        with open(nota, encoding="utf-8") as fh:
            h = json.load(fh)
    except Exception:
        raise SystemExit(0)
    pico = float(h.get("pico") or 0)
    dur = max(0, int(time.time()) - int(h.get("t0") or 0))
    pet = BI.leer_pet()
    if pico < 40:
        BI.contar(pet, "sesiones_bajo_40")
    if pico < 60:
        BI.contar(pet, "ctx_bajo")
    if pico >= 99.999:
        BI.contar(pet, "sesiones_ctx100")
    if dur and dur < 15 * 60:
        BI.contar(pet, "sesiones_cortas")
        BI.contar(pet, "sesiones_15min")
    if dur >= 4 * 3600:
        BI.contar(pet, "sesiones_largas")
        BI.contar(pet, "sesiones_4h")
    elif dur >= 90 * 60:
        BI.contar(pet, "sesiones_largas")
    # "5 dias seguidos en el mismo repo": solo cuenta el salto de dia.
    repo = h.get("repo") or ""
    hoy = time.strftime("%Y-%m-%d")
    if repo:
        ult = pet.get("repo_dia") or ""
        if ult != "%s|%s" % (repo, hoy):
            ayer = time.strftime("%Y-%m-%d", time.localtime(time.time() - 86400))
            seguido = ult == "%s|%s" % (repo, ayer)
            c = pet.setdefault("contadores", {})
            c["dias_mismo_repo"] = (int(c.get("dias_mismo_repo", 0)) + 1) if seguido else 1
            pet["repo_dia"] = "%s|%s" % (repo, hoy)
    BI.escribir_pet(pet)
    try:
        os.unlink(nota)
    except OSError:
        pass
    raise SystemExit(0)

# ---------------------------------------------------------------------------
# COMER — cualquier accion que no sea el panel es una comida.
# ---------------------------------------------------------------------------
if accion != "panel":
    evento = "feed" if accion == "feed" else accion
    if evento not in BI.COMIDA:
        sys.stderr.write("pet: no se come '%s'. Hay: %s\n"
                         % (accion, ", ".join(sorted(BI.COMIDA))))
        raise SystemExit(2)
    pet = BI.leer_pet()
    BI.pasar_hambre(pet)
    antes = BI.evolucion(pet)[0]
    pet, ok = BI.alimentar(pet, evento, nota)
    if not ok:
        print("%sya has llegado al tope de %s por hoy%s" % (c(BI.TENUE), evento, R))
        raise SystemExit(0)
    # Contadores de comportamiento: son los que eligen la rama al subir de nivel.
    for cont in {"tests": ("inquisitivo", "tests", "racha_tests"),
                 "commit": ("metodico", "diffs", "racha_diffs"),
                 "compact": ("metodico",),
                 "tarea": ("inquisitivo", "planes"),
                 "reventon": ("impulsivo", "ctx_limite"),
                 "feed": ()}.get(evento, ()):
        BI.contar(pet, cont)
    if evento == "reventon":          # una racha limpia se rompe al reventar
        pet["contadores"]["racha_tests"] = 0
        pet["contadores"]["racha_diffs"] = 0
    BI.escribir_pet(pet)
    despues = BI.evolucion(pet)[0]
    xp = BI.COMIDA[evento][0]
    col = BI.IDENT if xp > 0 else BI.MAL
    print("%s%+d xp%s %s· %s%s" % (c(col), xp, R, c(BI.TENUE), BI.COMIDA_ETQ[evento], R))
    if despues != antes:
        print("%s%s evoluciona: %s -> %s%s"
              % (c(BI.NUM), B, BI.BONITO.get(antes, antes),
                 BI.BONITO.get(despues, despues), R))
    raise SystemExit(0)

# ---------------------------------------------------------------------------
# EL PANEL
# ---------------------------------------------------------------------------
pet = BI.leer_pet()
BI.pasar_hambre(pet)
criatura, nivel = BI.evolucion(pet)
nombre = BI.BONITO.get(criatura, criatura)
xp = int(pet.get("xp", 0))
hambre = int(pet.get("hambre", 0))

# El bicho del panel se pinta a media vida: aqui interesa el progreso, no el uso.
est = BI.estado_de(30)
filas = BI.dibujar(criatura, est, paso=0, hambre=hambre, veinticuatro=_TRUE)

# El camino recorrido: temperamento -> oficio -> marca.
camino = [criatura]
while camino[0] in BI.PADRE:
    camino.insert(0, BI.PADRE[camino[0]])
camino = [BI.BONITO.get(x, x) for x in camino]

# Cuanta XP falta y en que se convertiria.
sig_xp = next((t for t, n in BI.NIVELES if t > xp), None)
sig_nom = None
if sig_xp is not None:
    fantasma = dict(pet, xp=sig_xp)
    s = BI.evolucion(fantasma)[0]
    sig_nom = BI.BONITO.get(s, s) if s != criatura else None

print()
print("  " + c(BI.RUTA) + B + "bicho" + R + "  " + c(BI.TENUE) + "/pet" + R)
print()
for f in filas:
    print("     " + f)
print()
print("  " + c(BI.NUM) + B + nombre + R + "   " + c(BI.TENUE) + "nivel " + R
      + c(BI.ENF) + str(nivel) + R + "   " + c(BI.TENUE)
      + (" " + c(BI.RAYA) + "›" + R + c(BI.TENUE) + " ").join(camino) + R)
print()
print("  " + c(BI.TENUE) + "xp     " + R + barra(xp, sig_xp or xp or 1, 16, BI.IDENT, BI.CTXV)
      + "  " + c(BI.ENF) + str(xp) + R)
_hc = BI.MAL if hambre >= BI.HAMBRE_AVISA else (BI.NUM if hambre >= 4 else BI.CUOTA)
print("  " + c(BI.TENUE) + "hambre " + R + barra(hambre, BI.HAMBRE_MAX, 10, _hc, BI.VACIO)
      + "  " + c(BI.ENF) + str(hambre) + R)
racha = int(pet.get("racha", 0))
print("  " + c(BI.TENUE) + "racha  " + R + barra(min(racha, 7), 7, 7, BI.LINK, BI.VACIO)
      + "  " + c(BI.ENF) + "%d día%s" % (racha, "" if racha == 1 else "s") + R + c(BI.TENUE)
      + " · mejor %d" % int(pet.get("mejor_racha", 0)) + R)
print()
linea = []
if sig_xp is not None:
    linea.append(c(BI.ENF) + str(sig_xp - xp) + R + c(BI.TENUE) + " para " + R
                 + c(BI.NUM) + (sig_nom or "nivel %d" % (nivel + 1)) + R)
comio = pet.get("comio") or 0
if comio:
    mins = int((time.time() - comio) // 60)
    cuando = "hace %dh %02dm" % divmod(mins, 60) if mins >= 60 else "hace %dm" % mins
    linea.append(c(BI.TENUE) + "comió " + cuando + R)
if linea:
    print("  " + (" " + c(BI.RAYA) + "│" + R + " ").join(linea))

hoy = pet.get("hoy") or []
if hoy and pet.get("hoy_dia") == time.strftime("%Y-%m-%d"):
    print()
    print("  " + c(BI.TENUE) + "hoy" + R)
    for e in hoy[-8:]:
        v = int(e.get("xp", 0))
        col = BI.IDENT if v > 0 else BI.MAL
        etq = BI.COMIDA_ETQ.get(e.get("q"), e.get("q", "?"))
        n = (e.get("n") or "")[:22]
        print("    %s%+4d%s  %s%-18s%s %s%-22s%s %s%s%s"
              % (c(col), v, R, c(BI.ENF), etq, R, c(BI.LINK), n, R,
                 c(BI.TENUE), time.strftime("%H:%M", time.localtime(e.get("t", 0))), R))
print()
PYEOF
